{
  "__inputs": [
    {
      "name": "DS_FRUGAL_IOT",
      "label": "Frugal IoT data source",
      "description": "The Infinity data source holding this organization's token",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    },
    {
      "name": "VAR_SERVER",
      "type": "constant",
      "label": "Server URL",
      "description": "Where the Frugal IoT server is, no trailing slash",
      "value": "https://frugaliot.naturalinnovation.org"
    },
    {
      "name": "VAR_ORG",
      "type": "constant",
      "label": "Organization",
      "description": "The organization the token is for",
      "value": "dev"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "yesoreyeram-infinity-datasource",
      "name": "Infinity",
      "version": "4.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "title": "Frugal IoT readings",
  "uid": "frugaliot-readings",
  "tags": [
    "frugal-iot"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "server",
        "type": "constant",
        "query": "${VAR_SERVER}",
        "hide": 2,
        "skipUrlSync": true
      },
      {
        "name": "org",
        "type": "constant",
        "query": "${VAR_ORG}",
        "hide": 2,
        "skipUrlSync": true
      },
      {
        "name": "topic",
        "type": "textbox",
        "label": "Topic",
        "query": "dev/lotus/esp32-944104/aht20/temperature",
        "description": "org/project/node/module/leaf - see GRAFANA.md for listing them"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "$topic",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_FRUGAL_IOT}"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_FRUGAL_IOT}"
          },
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "${server}/grafana/${org}/data?topic=${topic}&from=${__from}&to=${__to}&maxPoints=1000",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            }
          ]
        }
      ]
    }
  ]
}
