# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local

# npm package lock file (optional, if you don't want to commit it)
package-lock.json
yarn.lock

# Build output
dist/
build/

# Coverage directory (for testing)
coverage/

# IDE or Editor folders
.idea/
.vscode/

# Temporary files
*.swp
*.swo

# Dependency directories
bower_components/

# Optional REPL history files
.history

# TypeScript compiled files
*.tsbuildinfo

# Miscellaneous
*.tgz

# data folder
data/

#do not upload db files.
*.db
*.db.bak
*.db.*

*.sqlite
*.sqlite3

# do not upload configs for organizations as not secure
config.d/organizations/

# Generated per installation by frugal-iot-init, or by the server at startup if missing. Holds
# session_secret and user_secret, so it must never be committed. Note that running the test suite
# creates one here, because importing frugal-iot-server.js generates what it does not find.
config.d/secrets.yaml

# Access keys and credentials
firebase-service-account.json
